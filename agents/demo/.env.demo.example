# Configurações específicas do pipeline de DEMO
# Adicione estas variáveis no arquivo agents/.env antes da reunião

# Quantidade máxima de leads processados ao vivo (recomendado: 3 a 5)
DEMO_MAX_LEADS=4

# Pausa entre cada agente no pipeline (ms) — 3000 = 3 segundos
DEMO_PAUSA_MS=3000

# Intervalo comprimido Step 2 (simula D+3) em ms — 15000 = 15 segundos
DEMO_INTERVALO_STEP2_MS=15000

# Intervalo comprimido Step 3 (simula D+7) em ms — 30000 = 30 segundos
DEMO_INTERVALO_STEP3_MS=30000

# Probabilidade de abertura simulada (0.0 a 1.0) — 0.75 = 75%
DEMO_PROB_ABERTURA=0.75

# Probabilidade de resposta simulada entre os que abriram (0.0 a 1.0) — 0.35 = 35%
DEMO_PROB_RESPOSTA=0.35

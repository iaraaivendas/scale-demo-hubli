# Agentes I.Ara Scale — variáveis de ambiente
# Copie para .env e preencha os valores reais

OPENAI_API_KEY=sk-...

# URL da plataforma (para os agentes postarem logs e atualizarem leads)
PLATFORM_API_URL=http://localhost:3000

# Caminho para o CSV de leads
MOCK_DATA_PATH=../mock-data/leads_mock_demo.csv

# Google OAuth2 (Agente Dispatcher — envio real via Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

LOG_LEVEL=info
